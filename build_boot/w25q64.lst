  50:Core/Src/device/w25q64.c ****   static uint8_t SPI_SendByte(uint8_t tx)
  51:Core/Src/device/w25q64.c ****   {
  52:Core/Src/device/w25q64.c ****       uint8_t rx;
  53:Core/Src/device/w25q64.c ****       HAL_SPI_TransmitReceive(&hspi1, &tx, &rx, 1, 100);
