   1:Core/Src/device/w25q64.c **** /**
   2:Core/Src/device/w25q64.c ****  * @file    w25q64.c
   3:Core/Src/device/w25q64.c ****  * @brief   W25Q64 8MB SPI NOR Flash driver implementation
   4:Core/Src/device/w25q64.c ****  * @note    Uses SPI1 + PA4 as CS (GPIO Output).
   5:Core/Src/device/w25q64.c ****  *          HAL SPI blocking mode, suitable for FreeRTOS task context.
   6:Core/Src/device/w25q64.c ****  *
   7:Core/Src/device/w25q64.c ****  * W25Q64 command set:
   8:Core/Src/device/w25q64.c ****  *   0x06  Write Enable
   9:Core/Src/device/w25q64.c ****  *   0x05  Read Status Register 1
  10:Core/Src/device/w25q64.c ****  *   0x03  Read Data (standard, up to 50MHz)
  11:Core/Src/device/w25q64.c ****  *   0x02  Page Program (1~256 bytes)
  12:Core/Src/device/w25q64.c ****  *   0x20  Sector Erase (4KB)
  13:Core/Src/device/w25q64.c ****  *   0xD8  Block Erase (64KB)
  14:Core/Src/device/w25q64.c ****  *   0xC7  Chip Erase
  15:Core/Src/device/w25q64.c ****  *   0x9F  JEDEC ID
  16:Core/Src/device/w25q64.c ****  *   0xAB  Release Power-down / Device ID
  17:Core/Src/device/w25q64.c ****  */
  18:Core/Src/device/w25q64.c **** #include "w25q64.h"
  19:Core/Src/device/w25q64.c **** #include "main.h"
  20:Core/Src/device/w25q64.c **** #include <string.h>
  21:Core/Src/device/w25q64.c **** 
  22:Core/Src/device/w25q64.c **** #ifdef BOOTLOADER_BUILD
  23:Core/Src/device/w25q64.c ****   /* Bootloader: use minimal SPI driver (no HAL SPI) */
  24:Core/Src/device/w25q64.c ****   #include "stm32f1xx_hal.h"
  25:Core/Src/device/w25q64.c ****   extern void Boot_SPI_Init(void);
  26:Core/Src/device/w25q64.c ****   extern void Boot_SPI_CS_Low(void);
  27:Core/Src/device/w25q64.c ****   extern void Boot_SPI_CS_High(void);
  28:Core/Src/device/w25q64.c ****   extern uint8_t Boot_SPI_Transfer(uint8_t tx);
  29:Core/Src/device/w25q64.c **** 
  30:Core/Src/device/w25q64.c ****   #define CS_LOW()          Boot_SPI_CS_Low()
  31:Core/Src/device/w25q64.c ****   #define CS_HIGH()         Boot_SPI_CS_High()
  32:Core/Src/device/w25q64.c ****   #define SPI_SendByte(tx)  Boot_SPI_Transfer(tx)
ARM GAS  C:\Users\airforce\AppData\Local\Temp\cc4vm5jb.s 			page 2


  33:Core/Src/device/w25q64.c **** 
  34:Core/Src/device/w25q64.c ****   /* Bootloader init: just init SPI + CS */
  35:Core/Src/device/w25q64.c ****   #define W25Q64_HW_INIT()  do { \
  36:Core/Src/device/w25q64.c ****         GPIO_InitTypeDef _c = {0}; \
  37:Core/Src/device/w25q64.c ****         _c.Pin = GPIO_PIN_4; _c.Mode = GPIO_MODE_OUTPUT_PP; \
  38:Core/Src/device/w25q64.c ****         _c.Pull = GPIO_PULLUP; _c.Speed = GPIO_SPEED_FREQ_HIGH; \
  39:Core/Src/device/w25q64.c ****         HAL_GPIO_Init(GPIOA, &_c); \
  40:Core/Src/device/w25q64.c ****         Boot_SPI_Init(); \
  41:Core/Src/device/w25q64.c ****     } while(0)
  42:Core/Src/device/w25q64.c **** 
  43:Core/Src/device/w25q64.c **** #else
