 472:Core/Src/device/cjson.c **** 		entries=(char**)cJSON_malloc(numentries*sizeof(char*));
 473:Core/Src/device/cjson.c **** 		if (!entries) return 0;
 474:Core/Src/device/cjson.c **** 		memset(entries,0,numentries*sizeof(char*));
 475:Core/Src/device/cjson.c **** 		/* Retrieve all the results: */
 476:Core/Src/device/cjson.c **** 		child=item->child;
