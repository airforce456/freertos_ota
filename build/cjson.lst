 433:Core/Src/device/cjson.c **** /* Render an array to text */
 434:Core/Src/device/cjson.c **** static char *print_array(cJSON *item,int depth,int fmt,printbuffer *p)
 435:Core/Src/device/cjson.c **** {
 436:Core/Src/device/cjson.c **** 	char **entries;
 437:Core/Src/device/cjson.c **** 	char *out=0,*ptr,*ret;int len=5;
 438:Core/Src/device/cjson.c **** 	cJSON *child=item->child;
 439:Core/Src/device/cjson.c **** 	int numentries=0,i=0,fail=0;
 440:Core/Src/device/cjson.c **** 	size_t tmplen=0;
 441:Core/Src/device/cjson.c **** 	
 442:Core/Src/device/cjson.c **** 	/* How many entries in the array? */
 443:Core/Src/device/cjson.c **** 	while (child) numentries++,child=child->next;
 444:Core/Src/device/cjson.c **** 	/* Explicitly handle numentries==0 */
 445:Core/Src/device/cjson.c **** 	if (!numentries)
 446:Core/Src/device/cjson.c **** 	{
 447:Core/Src/device/cjson.c **** 		if (p)	out=ensure(p,3);
 448:Core/Src/device/cjson.c **** 		else	out=(char*)cJSON_malloc(3);
 449:Core/Src/device/cjson.c **** 		if (out) strcpy(out,"[]");
 450:Core/Src/device/cjson.c **** 		return out;
 451:Core/Src/device/cjson.c **** 	}
 452:Core/Src/device/cjson.c **** 
 453:Core/Src/device/cjson.c **** 	if (p)
 454:Core/Src/device/cjson.c **** 	{
 455:Core/Src/device/cjson.c **** 		/* Compose the output array. */
 456:Core/Src/device/cjson.c **** 		i=p->offset;
 457:Core/Src/device/cjson.c **** 		ptr=ensure(p,1);if (!ptr) return 0;	*ptr='[';	p->offset++;
 458:Core/Src/device/cjson.c **** 		child=item->child;
 459:Core/Src/device/cjson.c **** 		while (child && !fail)
 460:Core/Src/device/cjson.c **** 		{
