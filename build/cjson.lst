  95:Core/Src/device/cjson.c **** /* Parse the input text to generate a number, and populate the result into item. */
  96:Core/Src/device/cjson.c **** static const char *parse_number(cJSON *item,const char *num)
  97:Core/Src/device/cjson.c **** {
  98:Core/Src/device/cjson.c **** 	double n=0,sign=1,scale=0;int subscale=0,signsubscale=1;
  99:Core/Src/device/cjson.c **** 
 100:Core/Src/device/cjson.c **** 	if (*num=='-') sign=-1,num++;	/* Has sign? */
 101:Core/Src/device/cjson.c **** 	if (*num=='0') num++;			/* is zero */
 102:Core/Src/device/cjson.c **** 	if (*num>='1' && *num<='9')	do	n=(n*10.0)+(*num++ -'0');	while (*num>='0' && *num<='9');	/* Number
 103:Core/Src/device/cjson.c **** 	if (*num=='.' && num[1]>='0' && num[1]<='9') {num++;		do	n=(n*10.0)+(*num++ -'0'),scale--; while (
 104:Core/Src/device/cjson.c **** 	if (*num=='e' || *num=='E')		/* Exponent? */
 105:Core/Src/device/cjson.c **** 	{	num++;if (*num=='+') num++;	else if (*num=='-') signsubscale=-1,num++;		/* With sign? */
 106:Core/Src/device/cjson.c **** 		while (*num>='0' && *num<='9') subscale=(subscale*10)+(*num++ - '0');	/* Number? */
 107:Core/Src/device/cjson.c **** 	}
 108:Core/Src/device/cjson.c **** 
 109:Core/Src/device/cjson.c **** 	n=sign*n*pow(10.0,(scale+subscale*signsubscale));	/* number = +/- number.fraction * 10^+/- exponen
 110:Core/Src/device/cjson.c **** 	
 111:Core/Src/device/cjson.c **** 	item->valuedouble=n;
 112:Core/Src/device/cjson.c **** 	item->valueint=(int)n;
 113:Core/Src/device/cjson.c **** 	item->type=cJSON_Number;
 114:Core/Src/device/cjson.c **** 	return num;
 115:Core/Src/device/cjson.c **** }
 116:Core/Src/device/cjson.c **** 
 117:Core/Src/device/cjson.c **** static int pow2gt (int x)	{	--x;	x|=x>>1;	x|=x>>2;	x|=x>>4;	x|=x>>8;	x|=x>>16;	return x+1;	}
 118:Core/Src/device/cjson.c **** 
 119:Core/Src/device/cjson.c **** typedef struct {char *buffer; int length; int offset; } printbuffer;
 120:Core/Src/device/cjson.c **** 
 121:Core/Src/device/cjson.c **** static char* ensure(printbuffer *p,int needed)
 122:Core/Src/device/cjson.c **** {
 123:Core/Src/device/cjson.c **** 	char *newbuffer;int newsize;
 124:Core/Src/device/cjson.c **** 	if (!p || !p->buffer) return 0;
 125:Core/Src/device/cjson.c **** 	needed+=p->offset;
 126:Core/Src/device/cjson.c **** 	if (needed<=p->length) return p->buffer+p->offset;
 127:Core/Src/device/cjson.c **** 
 128:Core/Src/device/cjson.c **** 	newsize=pow2gt(needed);
 129:Core/Src/device/cjson.c **** 	newbuffer=(char*)cJSON_malloc(newsize);
 130:Core/Src/device/cjson.c **** 	if (!newbuffer) {cJSON_free(p->buffer);p->length=0,p->buffer=0;return 0;}
 131:Core/Src/device/cjson.c **** 	if (newbuffer) memcpy(newbuffer,p->buffer,p->length);
 132:Core/Src/device/cjson.c **** 	cJSON_free(p->buffer);
 133:Core/Src/device/cjson.c **** 	p->length=newsize;
 134:Core/Src/device/cjson.c **** 	p->buffer=newbuffer;
 135:Core/Src/device/cjson.c **** 	return newbuffer+p->offset;
 136:Core/Src/device/cjson.c **** }
 137:Core/Src/device/cjson.c **** 
 138:Core/Src/device/cjson.c **** static int update(printbuffer *p)
 139:Core/Src/device/cjson.c **** {
 140:Core/Src/device/cjson.c **** 	char *str;
 141:Core/Src/device/cjson.c **** 	if (!p || !p->buffer) return 0;
 142:Core/Src/device/cjson.c **** 	str=p->buffer+p->offset;
 143:Core/Src/device/cjson.c **** 	return p->offset+strlen(str);
 144:Core/Src/device/cjson.c **** }
