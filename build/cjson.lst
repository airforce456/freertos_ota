  95:Core/Src/device/cjson.c **** /* Parse the input text to generate a number, and populate the result into item. */
  96:Core/Src/device/cjson.c **** static const char *parse_number(cJSON *item,const char *num)
  97:Core/Src/device/cjson.c **** {
  98:Core/Src/device/cjson.c **** 	double n=0,sign=1,scale=0;int subscale=0,signsubscale=1;
  99:Core/Src/device/cjson.c **** 
 100:Core/Src/device/cjson.c **** 	if (*num=='-') sign=-1,num++;	/* Has sign? */
 101:Core/Src/device/cjson.c **** 	if (*num=='0') num++;			/* is zero */
 102:Core/Src/device/cjson.c **** 	if (*num>='1' && *num<='9')	do	n=(n*10.0)+(*num++ -'0');	while (*num>='0' && *num<='9');	/* Number
 103:Core/Src/device/cjson.c **** 	if (*num=='.' && num[1]>='0' && num[1]<='9') {num++;		do	n=(n*10.0)+(*num++ -'0'),scale--; while (
 104:Core/Src/device/cjson.c **** 	if (*num=='e' || *num=='E')		/* Exponent? */
 105:Core/Src/device/cjson.c **** 	{	num++;if (*num=='+') num++;	else if (*num=='-') signsubscale=-1,num++;		/* With sign? */
 106:Core/Src/device/cjson.c **** 		while (*num>='0' && *num<='9') subscale=(subscale*10)+(*num++ - '0');	/* Number? */
 107:Core/Src/device/cjson.c **** 	}
 108:Core/Src/device/cjson.c **** 
 109:Core/Src/device/cjson.c **** 	n=sign*n*pow(10.0,(scale+subscale*signsubscale));	/* number = +/- number.fraction * 10^+/- exponen
 110:Core/Src/device/cjson.c **** 	
 111:Core/Src/device/cjson.c **** 	item->valuedouble=n;
ARM GAS  C:\Users\airforce\AppData\Local\Temp\ccQBkyua.s 			page 6


 112:Core/Src/device/cjson.c **** 	item->valueint=(int)n;
 113:Core/Src/device/cjson.c **** 	item->type=cJSON_Number;
 114:Core/Src/device/cjson.c **** 	return num;
 115:Core/Src/device/cjson.c **** }
