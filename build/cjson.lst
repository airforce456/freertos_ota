  49:Core/Src/device/cjson.c **** static char* cJSON_strdup(const char* str)
  50:Core/Src/device/cjson.c **** {
  51:Core/Src/device/cjson.c ****       size_t len;
  52:Core/Src/device/cjson.c ****       char* copy;
  53:Core/Src/device/cjson.c **** 
  54:Core/Src/device/cjson.c ****       len = strlen(str) + 1;
  55:Core/Src/device/cjson.c ****       if (!(copy = (char*)cJSON_malloc(len))) return 0;
  56:Core/Src/device/cjson.c ****       memcpy(copy,str,len);
  57:Core/Src/device/cjson.c ****       return copy;
  58:Core/Src/device/cjson.c **** }
