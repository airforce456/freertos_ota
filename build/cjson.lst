 405:Core/Src/device/cjson.c **** /* Build an array from input text. */
 406:Core/Src/device/cjson.c **** static const char *parse_array(cJSON *item,const char *value)
 407:Core/Src/device/cjson.c **** {
 408:Core/Src/device/cjson.c **** 	cJSON *child;
