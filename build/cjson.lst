 357:Core/Src/device/cjson.c **** static const char *parse_value(cJSON *item,const char *value)
 358:Core/Src/device/cjson.c **** {
 359:Core/Src/device/cjson.c **** 	if (!value)						return 0;	/* Fail on null. */
 360:Core/Src/device/cjson.c **** 	if (!strncmp(value,"null",4))	{ item->type=cJSON_NULL;  return value+4; }
 361:Core/Src/device/cjson.c **** 	if (!strncmp(value,"false",5))	{ item->type=cJSON_False; return value+5; }
 362:Core/Src/device/cjson.c **** 	if (!strncmp(value,"true",4))	{ item->type=cJSON_True; item->valueint=1;	return value+4; }
 363:Core/Src/device/cjson.c **** 	if (*value=='\"')				{ return parse_string(item,value); }
 364:Core/Src/device/cjson.c **** 	if (*value=='-' || (*value>='0' && *value<='9'))	{ return parse_number(item,value); }
 365:Core/Src/device/cjson.c **** 	if (*value=='[')				{ return parse_array(item,value); }
 366:Core/Src/device/cjson.c **** 	if (*value=='{')				{ return parse_object(item,value); }
 367:Core/Src/device/cjson.c **** 
 368:Core/Src/device/cjson.c **** 	ep=value;return 0;	/* failure. */
 369:Core/Src/device/cjson.c **** }
 370:Core/Src/device/cjson.c **** 
 371:Core/Src/device/cjson.c **** /* Render a value to text. */
 372:Core/Src/device/cjson.c **** static char *print_value(cJSON *item,int depth,int fmt,printbuffer *p)
 373:Core/Src/device/cjson.c **** {
 374:Core/Src/device/cjson.c **** 	char *out=0;
 375:Core/Src/device/cjson.c **** 	if (!item) return 0;
 376:Core/Src/device/cjson.c **** 	if (p)
 377:Core/Src/device/cjson.c **** 	{
 378:Core/Src/device/cjson.c **** 		switch ((item->type)&255)
 379:Core/Src/device/cjson.c **** 		{
 380:Core/Src/device/cjson.c **** 			case cJSON_NULL:	{out=ensure(p,5);	if (out) strcpy(out,"null");	break;}
 381:Core/Src/device/cjson.c **** 			case cJSON_False:	{out=ensure(p,6);	if (out) strcpy(out,"false");	break;}
 382:Core/Src/device/cjson.c **** 			case cJSON_True:	{out=ensure(p,5);	if (out) strcpy(out,"true");	break;}
 383:Core/Src/device/cjson.c **** 			case cJSON_Number:	out=print_number(item,p);break;
 384:Core/Src/device/cjson.c **** 			case cJSON_String:	out=print_string(item,p);break;
 385:Core/Src/device/cjson.c **** 			case cJSON_Array:	out=print_array(item,depth,fmt,p);break;
 386:Core/Src/device/cjson.c **** 			case cJSON_Object:	out=print_object(item,depth,fmt,p);break;
 387:Core/Src/device/cjson.c **** 		}
 388:Core/Src/device/cjson.c **** 	}
 389:Core/Src/device/cjson.c **** 	else
 390:Core/Src/device/cjson.c **** 	{
 391:Core/Src/device/cjson.c **** 		switch ((item->type)&255)
 392:Core/Src/device/cjson.c **** 		{
 393:Core/Src/device/cjson.c **** 			case cJSON_NULL:	out=cJSON_strdup("null");	break;
 394:Core/Src/device/cjson.c **** 			case cJSON_False:	out=cJSON_strdup("false");break;
 395:Core/Src/device/cjson.c **** 			case cJSON_True:	out=cJSON_strdup("true"); break;
 396:Core/Src/device/cjson.c **** 			case cJSON_Number:	out=print_number(item,0);break;
 397:Core/Src/device/cjson.c **** 			case cJSON_String:	out=print_string(item,0);break;
 398:Core/Src/device/cjson.c **** 			case cJSON_Array:	out=print_array(item,depth,fmt,0);break;
 399:Core/Src/device/cjson.c **** 			case cJSON_Object:	out=print_object(item,depth,fmt,0);break;
 400:Core/Src/device/cjson.c **** 		}
 401:Core/Src/device/cjson.c **** 	}
 402:Core/Src/device/cjson.c **** 	return out;
 403:Core/Src/device/cjson.c **** }
