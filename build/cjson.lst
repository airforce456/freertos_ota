  39:Core/Src/device/cjson.c **** static int cJSON_strcasecmp(const char *s1,const char *s2)
  40:Core/Src/device/cjson.c **** {
  41:Core/Src/device/cjson.c **** 	if (!s1) return (s1==s2)?0:1;if (!s2) return 1;
  42:Core/Src/device/cjson.c **** 	for(; tolower(*s1) == tolower(*s2); ++s1, ++s2)	if(*s1 == 0)	return 0;
  43:Core/Src/device/cjson.c **** 	return tolower(*(const unsigned char *)s1) - tolower(*(const unsigned char *)s2);
  44:Core/Src/device/cjson.c **** }
