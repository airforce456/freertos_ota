  85:Core/Src/device/cjson.c **** 	{
  86:Core/Src/device/cjson.c **** 		next=c->next;
  87:Core/Src/device/cjson.c **** 		if (!(c->type&cJSON_IsReference) && c->child) cJSON_Delete(c->child);
  88:Core/Src/device/cjson.c **** 		if (!(c->type&cJSON_IsReference) && c->valuestring) cJSON_free(c->valuestring);
  89:Core/Src/device/cjson.c **** 		if (!(c->type&cJSON_StringIsConst) && c->string) cJSON_free(c->string);
  90:Core/Src/device/cjson.c **** 		cJSON_free(c);
  91:Core/Src/device/cjson.c **** 		c=next;
  92:Core/Src/device/cjson.c **** 	}
  93:Core/Src/device/cjson.c **** }
