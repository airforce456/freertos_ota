 146:Core/Src/device/cjson.c **** /* Render the number nicely from the given item into a string. */
 147:Core/Src/device/cjson.c **** static char *print_number(cJSON *item,printbuffer *p)
 148:Core/Src/device/cjson.c **** {
 149:Core/Src/device/cjson.c **** 	char *str=0;
 150:Core/Src/device/cjson.c **** 	double d=item->valuedouble;
 151:Core/Src/device/cjson.c **** 	if (d==0)
 152:Core/Src/device/cjson.c **** 	{
 153:Core/Src/device/cjson.c **** 		if (p)	str=ensure(p,2);
 154:Core/Src/device/cjson.c **** 		else	str=(char*)cJSON_malloc(2);	/* special case for 0. */
 155:Core/Src/device/cjson.c **** 		if (str) strcpy(str,"0");
 156:Core/Src/device/cjson.c **** 	}
 157:Core/Src/device/cjson.c **** 	else if (fabs(((double)item->valueint)-d)<=DBL_EPSILON && d<=INT_MAX && d>=INT_MIN)
 158:Core/Src/device/cjson.c **** 	{
 159:Core/Src/device/cjson.c **** 		if (p)	str=ensure(p,21);
 160:Core/Src/device/cjson.c **** 		else	str=(char*)cJSON_malloc(21);	/* 2^64+1 can be represented in 21 chars. */
 161:Core/Src/device/cjson.c **** 		if (str)	sprintf(str,"%d",item->valueint);
 162:Core/Src/device/cjson.c **** 	}
