   1:Core/Src/device/at24c02.c **** /**
   2:Core/Src/device/at24c02.c ****  * @file    at24c02.c
   3:Core/Src/device/at24c02.c ****  * @brief   AT24C02 256-byte I2C EEPROM driver implementation
   4:Core/Src/device/at24c02.c ****  * @note    Uses soft I2C (PB6/PB7), shared with OLED & MPU6050.
   5:Core/Src/device/at24c02.c ****  *          APP mode: protected by xI2CMutex, uses vTaskDelay.
   6:Core/Src/device/at24c02.c ****  *          BOOT mode (#define BOOTLOADER_BUILD): no RTOS, uses HAL_Delay.
   7:Core/Src/device/at24c02.c ****  */
   8:Core/Src/device/at24c02.c **** #include "at24c02.h"
   9:Core/Src/device/at24c02.c **** #include "bsp_i2c.h"
  10:Core/Src/device/at24c02.c **** #include <string.h>
  11:Core/Src/device/at24c02.c **** 
  12:Core/Src/device/at24c02.c **** #ifdef BOOTLOADER_BUILD
  13:Core/Src/device/at24c02.c ****   /* Bootloader: single-threaded, no lock needed.
  14:Core/Src/device/at24c02.c ****    * Use simple NOP-loop delay (no HAL_Delay, no TIM2 dependency).
  15:Core/Src/device/at24c02.c ****    * HSI 8MHz, ~5 cycles per loop → ~200000 iterations ≈ 1ms */
  16:Core/Src/device/at24c02.c ****   static void Boot_DelayMs(uint32_t ms) {
  17:Core/Src/device/at24c02.c ****       for (uint32_t i = 0; i < ms; i++) {
  18:Core/Src/device/at24c02.c ****           for (volatile uint32_t j = 0; j < 2000; j++);
  19:Core/Src/device/at24c02.c ****       }
  20:Core/Src/device/at24c02.c ****   }
  21:Core/Src/device/at24c02.c ****   #define EE_LOCK()       (true)
  22:Core/Src/device/at24c02.c ****   #define EE_UNLOCK()
  23:Core/Src/device/at24c02.c ****   #define EE_DELAY_MS(ms) Boot_DelayMs(ms)
  24:Core/Src/device/at24c02.c **** #else
  25:Core/Src/device/at24c02.c ****   /* APP: FreeRTOS mutex protection */
  26:Core/Src/device/at24c02.c ****   #include "FreeRTOS.h"
  27:Core/Src/device/at24c02.c ****   #include "semphr.h"
  28:Core/Src/device/at24c02.c ****   extern SemaphoreHandle_t xI2CMutex;
  29:Core/Src/device/at24c02.c ****   #define EE_LOCK()       (xSemaphoreTake(xI2CMutex, pdMS_TO_TICKS(100)) == pdPASS)
  30:Core/Src/device/at24c02.c ****   #define EE_UNLOCK()     xSemaphoreGive(xI2CMutex)
  31:Core/Src/device/at24c02.c ****   #define EE_DELAY_MS(ms) vTaskDelay(pdMS_TO_TICKS(ms))
ARM GAS  C:\Users\airforce\AppData\Local\Temp\ccJD2seh.s 			page 2


