 163:Middlewares/FreeRTOS/Source/stream_buffer.c **** /*
 164:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * Add xCount bytes from pucData into the pxStreamBuffer's data storage area.
 165:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * This function does not update the buffer's xHead pointer, so multiple writes
 166:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * may be chained together "atomically". This is useful for Message Buffers where
 167:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * the length and data bytes are written in two separate chunks, and we don't want
 168:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * the reader to see the buffer as having grown until after all data is copied over.
 169:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * This function takes a custom xHead value to indicate where to write to (necessary
 170:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * for chaining) and returns the the resulting xHead position.
 171:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * To mark the write as complete, manually set the buffer's xHead field with the
 172:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * returned xHead from this function.
 173:Middlewares/FreeRTOS/Source/stream_buffer.c ****  */
 174:Middlewares/FreeRTOS/Source/stream_buffer.c **** static size_t prvWriteBytesToBuffer( StreamBuffer_t * const pxStreamBuffer,
 175:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                      const uint8_t * pucData,
 176:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                      size_t xCount,
 177:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                      size_t xHead ) PRIVILEGED_FUNCTION;
 178:Middlewares/FreeRTOS/Source/stream_buffer.c **** 
 179:Middlewares/FreeRTOS/Source/stream_buffer.c **** /*
 180:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * If the stream buffer is being used as a message buffer, then reads an entire
 181:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * message out of the buffer.  If the stream buffer is being used as a stream
 182:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * buffer then read as many bytes as possible from the buffer.
 183:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * prvReadBytesFromBuffer() is called to actually extract the bytes from the
 184:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * buffer's data storage area.
 185:Middlewares/FreeRTOS/Source/stream_buffer.c ****  */
 186:Middlewares/FreeRTOS/Source/stream_buffer.c **** static size_t prvReadMessageFromBuffer( StreamBuffer_t * pxStreamBuffer,
 187:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                         void * pvRxData,
 188:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                         size_t xBufferLengthBytes,
 189:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                         size_t xBytesAvailable ) PRIVILEGED_FUNCTION;
 190:Middlewares/FreeRTOS/Source/stream_buffer.c **** 
 191:Middlewares/FreeRTOS/Source/stream_buffer.c **** /*
 192:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * If the stream buffer is being used as a message buffer, then writes an entire
 193:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * message to the buffer.  If the stream buffer is being used as a stream
 194:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * buffer then write as many bytes as possible to the buffer.
 195:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * prvWriteBytestoBuffer() is called to actually send the bytes to the buffer's
 196:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * data storage area.
 197:Middlewares/FreeRTOS/Source/stream_buffer.c ****  */
