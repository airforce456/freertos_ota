 201:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                        size_t xSpace,
 202:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                        size_t xRequiredSpace ) PRIVILEGED_FUNCTION;
