 204:Middlewares/FreeRTOS/Source/stream_buffer.c **** /*
 205:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * Copies xCount bytes from the pxStreamBuffer's data storage area to pucData.
 206:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * This function does not update the buffer's xTail pointer, so multiple reads
 207:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * may be chained together "atomically". This is useful for Message Buffers where
 208:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * the length and data bytes are read in two separate chunks, and we don't want
 209:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * the writer to see the buffer as having more free space until after all data is
 210:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * copied over, especially if we have to abort the read due to insufficient receiving space.
 211:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * This function takes a custom xTail value to indicate where to read from (necessary
 212:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * for chaining) and returns the the resulting xTail position.
 213:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * To mark the read as complete, manually set the buffer's xTail field with the
 214:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * returned xTail from this function.
 215:Middlewares/FreeRTOS/Source/stream_buffer.c ****  */
 216:Middlewares/FreeRTOS/Source/stream_buffer.c **** static size_t prvReadBytesFromBuffer( StreamBuffer_t * pxStreamBuffer,
 217:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                       uint8_t * pucData,
 218:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                       size_t xCount,
 219:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                       size_t xTail ) PRIVILEGED_FUNCTION;
 220:Middlewares/FreeRTOS/Source/stream_buffer.c **** 
 221:Middlewares/FreeRTOS/Source/stream_buffer.c **** /*
 222:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * Called by both pxStreamBufferCreate() and pxStreamBufferCreateStatic() to
 223:Middlewares/FreeRTOS/Source/stream_buffer.c ****  * initialise the members of the newly created stream buffer structure.
 224:Middlewares/FreeRTOS/Source/stream_buffer.c ****  */
 225:Middlewares/FreeRTOS/Source/stream_buffer.c **** static void prvInitialiseNewStreamBuffer( StreamBuffer_t * const pxStreamBuffer,
 226:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                           uint8_t * const pucBuffer,
 227:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                           size_t xBufferSizeBytes,
 228:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                           size_t xTriggerLevelBytes,
 229:Middlewares/FreeRTOS/Source/stream_buffer.c ****                                           uint8_t ucFlags ) PRIVILEGED_FUNCTION;
