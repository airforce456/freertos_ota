 173:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             if( ( xWantedSize > 0 ) && ( xWantedSize <= xFreeBytesRemaining ) )
 174:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             {
 175:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 /* Traverse the list from the start (lowest address) block until
