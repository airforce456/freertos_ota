 192:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     pvReturn = ( void * ) ( ( ( uint8_t * ) pxPreviousBlock->pxNextFreeBlock ) + xH
 193:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
 194:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     /* This block is being returned for use so must be taken out
 195:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                      * of the list of free blocks. */
 196:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     pxPreviousBlock->pxNextFreeBlock = pxBlock->pxNextFreeBlock;
