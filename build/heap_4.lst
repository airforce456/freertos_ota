  36:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****  */
  37:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** #include <stdlib.h>
  38:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
  39:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** /* Defining MPU_WRAPPERS_INCLUDED_FROM_API_FILE prevents task.h from redefining
  40:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****  * all the API functions to use the MPU wrappers.  That should only be done when
