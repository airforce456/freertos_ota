 138:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****          * kernel, so it must be free. */
 139:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****         if( ( xWantedSize & xBlockAllocatedBit ) == 0 )
 140:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****         {
 141:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             /* The wanted size must be increased so it can contain a BlockLink_t
 142:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****              * structure in addition to the requested amount of bytes. */
 143:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             if( ( xWantedSize > 0 ) &&
 144:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 ( ( xWantedSize + xHeapStructSize ) >  xWantedSize ) ) /* Overflow check */
 145:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             {
 146:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 xWantedSize += xHeapStructSize;
