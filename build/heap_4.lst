  95:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** /* The size of the structure placed at the beginning of each allocated memory
  96:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****  * block must by correctly byte aligned. */
  97:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** static const size_t xHeapStructSize = ( sizeof( BlockLink_t ) + ( ( size_t ) ( portBYTE_ALIGNMENT -
  98:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
  99:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** /* Create a couple of list links to mark the start and end of the list. */
 100:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** PRIVILEGED_DATA static BlockLink_t xStart, * pxEnd = NULL;
 101:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
 102:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** /* Keeps track of the number of calls to allocate and free memory as well as the
 103:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****  * number of free bytes remaining, but says nothing about fragmentation. */
 104:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** PRIVILEGED_DATA static size_t xFreeBytesRemaining = 0U;
 105:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** PRIVILEGED_DATA static size_t xMinimumEverFreeBytesRemaining = 0U;
 106:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** PRIVILEGED_DATA static size_t xNumberOfSuccessfulAllocations = 0;
 107:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** PRIVILEGED_DATA static size_t xNumberOfSuccessfulFrees = 0;
 108:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
 109:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** /* Gets set to the top bit of an size_t type.  When this bit in the xBlockSize
 110:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****  * member of an BlockLink_t structure is set then the block belongs to the
 111:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****  * application.  When the bit is free the block is still part of the free heap
 112:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****  * space. */
 113:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** PRIVILEGED_DATA static size_t xBlockAllocatedBit = 0;
 114:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
 115:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** /*-----------------------------------------------------------*/
 116:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
 117:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** void * pvPortMalloc( size_t xWantedSize )
 118:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** {
 119:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****     BlockLink_t * pxBlock, * pxPreviousBlock, * pxNewBlockLink;
 120:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****     void * pvReturn = NULL;
 121:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
 122:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****     vTaskSuspendAll();
 123:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****     {
 124:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****         /* If this is the first call to malloc then the heap will require
 125:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****          * initialisation to setup the list of free blocks. */
 126:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****         if( pxEnd == NULL )
 127:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****         {
 128:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             prvHeapInit();
 129:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****         }
 130:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****         else
 131:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****         {
 132:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             mtCOVERAGE_TEST_MARKER();
 133:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****         }
 134:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
 135:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****         /* Check the requested block size is not so large that the top bit is
 136:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****          * set.  The top bit of the block size member of the BlockLink_t structure
 137:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****          * is used to determine who owns the block - the application or the
 138:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****          * kernel, so it must be free. */
 139:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****         if( ( xWantedSize & xBlockAllocatedBit ) == 0 )
 140:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****         {
 141:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             /* The wanted size must be increased so it can contain a BlockLink_t
 142:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****              * structure in addition to the requested amount of bytes. */
 143:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             if( ( xWantedSize > 0 ) &&
 144:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 ( ( xWantedSize + xHeapStructSize ) >  xWantedSize ) ) /* Overflow check */
 145:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             {
 146:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 xWantedSize += xHeapStructSize;
 147:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
ARM GAS  C:\Users\airforce\AppData\Local\Temp\cc9PxxMh.s 			page 4


 148:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 /* Ensure that blocks are always aligned. */
 149:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 if( ( xWantedSize & portBYTE_ALIGNMENT_MASK ) != 0x00 )
 150:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 {
 151:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     /* Byte alignment required. Check for overflow. */
 152:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     if( ( xWantedSize + ( portBYTE_ALIGNMENT - ( xWantedSize & portBYTE_ALIGNMENT_M
 153:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                             > xWantedSize )
 154:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     {
 155:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                         xWantedSize += ( portBYTE_ALIGNMENT - ( xWantedSize & portBYTE_ALIGNMENT_MA
 156:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                         configASSERT( ( xWantedSize & portBYTE_ALIGNMENT_MASK ) == 0 );
 157:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     }
 158:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     else
 159:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     {
 160:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                         xWantedSize = 0;
 161:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     }
 162:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 }
 163:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 else
 164:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 {
 165:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     mtCOVERAGE_TEST_MARKER();
 166:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 }
 167:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             }
 168:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             else
 169:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             {
 170:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 xWantedSize = 0;
 171:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             }
 172:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
 173:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             if( ( xWantedSize > 0 ) && ( xWantedSize <= xFreeBytesRemaining ) )
 174:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****             {
 175:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 /* Traverse the list from the start (lowest address) block until
 176:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                  * one of adequate size is found. */
 177:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 pxPreviousBlock = &xStart;
 178:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 pxBlock = xStart.pxNextFreeBlock;
 179:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
 180:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 while( ( pxBlock->xBlockSize < xWantedSize ) && ( pxBlock->pxNextFreeBlock != NULL 
 181:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 {
 182:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     pxPreviousBlock = pxBlock;
 183:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     pxBlock = pxBlock->pxNextFreeBlock;
 184:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 }
 185:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
 186:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 /* If the end marker was reached then a block of adequate size
 187:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                  * was not found. */
 188:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 if( pxBlock != pxEnd )
 189:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                 {
 190:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     /* Return the memory space pointed to - jumping over the
 191:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                      * BlockLink_t structure at its start. */
 192:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     pvReturn = ( void * ) ( ( ( uint8_t * ) pxPreviousBlock->pxNextFreeBlock ) + xH
 193:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
 194:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     /* This block is being returned for use so must be taken out
 195:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                      * of the list of free blocks. */
 196:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     pxPreviousBlock->pxNextFreeBlock = pxBlock->pxNextFreeBlock;
 197:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
 198:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     /* If the block is larger than required it can be split into
 199:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                      * two. */
 200:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     if( ( pxBlock->xBlockSize - xWantedSize ) > heapMINIMUM_BLOCK_SIZE )
 201:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****                     {
