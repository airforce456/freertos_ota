  53:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** /* Block sizes must not get too small. */
  54:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** #define heapMINIMUM_BLOCK_SIZE    ( ( size_t ) ( xHeapStructSize << 1 ) )
  55:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** 
