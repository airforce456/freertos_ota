 109:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** /* Gets set to the top bit of an size_t type.  When this bit in the xBlockSize
 110:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****  * member of an BlockLink_t structure is set then the block belongs to the
 111:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****  * application.  When the bit is free the block is still part of the free heap
 112:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c ****  * space. */
 113:Middlewares/FreeRTOS/Source/portable/MemMang/heap_4.c **** PRIVILEGED_DATA static size_t xBlockAllocatedBit = 0;
