 132:Core/Src/device/onenet.c ****         "Authorization:%s\r\n"
 133:Core/Src/device/onenet.c ****         "Host:ota.heclouds.com\r\n"
 134:Core/Src/device/onenet.c ****         "Content-Type:application/json\r\n"
 135:Core/Src/device/onenet.c ****         "Content-Length:%d\r\n\r\n"
 136:Core/Src/device/onenet.c ****         "{\"name\":\"%s\"}",
