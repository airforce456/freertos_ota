  30:Core/Src/device/onenet.c **** /* ==================================================================
  31:Core/Src/device/onenet.c ****  *  OTA_UrlEncode — sign 的 URL 编码
  32:Core/Src/device/onenet.c ****  * ================================================================== */
  33:Core/Src/device/onenet.c **** static unsigned char OTA_UrlEncode(char *sign)
  34:Core/Src/device/onenet.c **** {
  35:Core/Src/device/onenet.c ****     char sign_t[40];
  36:Core/Src/device/onenet.c ****     unsigned char i = 0, j = 0;
  37:Core/Src/device/onenet.c ****     unsigned char sign_len = strlen(sign);
  38:Core/Src/device/onenet.c **** 
  39:Core/Src/device/onenet.c ****     if (sign == NULL || sign_len < 28) return 1;
  40:Core/Src/device/onenet.c **** 
  41:Core/Src/device/onenet.c ****     for (; i < sign_len; i++) { sign_t[i] = sign[i]; sign[i] = 0; }
  42:Core/Src/device/onenet.c ****     sign_t[i] = 0;
  43:Core/Src/device/onenet.c **** 
  44:Core/Src/device/onenet.c ****     for (i = 0, j = 0; i < sign_len; i++) {
  45:Core/Src/device/onenet.c ****         switch (sign_t[i]) {
  46:Core/Src/device/onenet.c ****             case '+': strcat(sign + j, "%2B"); j += 3; break;
  47:Core/Src/device/onenet.c ****             case ' ': strcat(sign + j, "%20"); j += 3; break;
  48:Core/Src/device/onenet.c ****             case '/': strcat(sign + j, "%2F"); j += 3; break;
  49:Core/Src/device/onenet.c ****             case '?': strcat(sign + j, "%3F"); j += 3; break;
  50:Core/Src/device/onenet.c ****             case '%': strcat(sign + j, "%25"); j += 3; break;
  51:Core/Src/device/onenet.c ****             case '#': strcat(sign + j, "%23"); j += 3; break;
  52:Core/Src/device/onenet.c ****             case '&': strcat(sign + j, "%26"); j += 3; break;
  53:Core/Src/device/onenet.c ****             case '=': strcat(sign + j, "%3D"); j += 3; break;
  54:Core/Src/device/onenet.c ****             default:  sign[j] = sign_t[i];    j++;     break;
  55:Core/Src/device/onenet.c ****         }
  56:Core/Src/device/onenet.c ****     }
  57:Core/Src/device/onenet.c ****     sign[j] = 0;
  58:Core/Src/device/onenet.c ****     return 0;
  59:Core/Src/device/onenet.c **** }
