 191:Core/Src/device/onenet.c ****             switch (MQTT_UnPacketConnectAck(dataPtr)) {
 192:Core/Src/device/onenet.c ****                 case 0: printf("[ONENET] MQTT Connected!\r\n"); status = 0; break;
 193:Core/Src/device/onenet.c ****                 case 1: printf("[ONENET] MQTT: protocol error\r\n"); break;
 194:Core/Src/device/onenet.c ****                 case 2: printf("[ONENET] MQTT: bad clientid\r\n"); break;
 195:Core/Src/device/onenet.c ****                 case 3: printf("[ONENET] MQTT: server error\r\n"); break;
 196:Core/Src/device/onenet.c ****                 case 4: printf("[ONENET] MQTT: bad user/pass\r\n"); break;
 197:Core/Src/device/onenet.c ****                 case 5: printf("[ONENET] MQTT: bad token\r\n"); break;
 198:Core/Src/device/onenet.c ****                 default:printf("[ONENET] MQTT: unknown error\r\n"); break;
 199:Core/Src/device/onenet.c ****             }
 200:Core/Src/device/onenet.c ****         }
 201:Core/Src/device/onenet.c ****         MQTT_DeleteBuffer(&mqttPacket);
 202:Core/Src/device/onenet.c ****     } else {
 203:Core/Src/device/onenet.c ****         printf("[ONENET] MQTT_PacketConnect failed\r\n");
 204:Core/Src/device/onenet.c ****     }
 205:Core/Src/device/onenet.c ****     return status;
 206:Core/Src/device/onenet.c **** }
