 146:Core/Src/device/onenet.c ****         if (sscanf(data_ptr,
 147:Core/Src/device/onenet.c ****             "device_id\" : \"%[^\"]\",\r\n\"name\" : \"%[^\"]\",\r\n\r\n\"pid\" : %d,\r\n\"key\" : 
 148:Core/Src/device/onenet.c ****             onenet_devid, name, &pid, onenet_key) == 4) {
