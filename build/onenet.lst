 109:Core/Src/device/onenet.c **** bool OneNET_RegisterDevice(void)
 110:Core/Src/device/onenet.c **** {
 111:Core/Src/device/onenet.c ****     bool result = true;
 112:Core/Src/device/onenet.c ****     unsigned short send_len = 11 + strlen(ONENET_DEV_NAME);
 113:Core/Src/device/onenet.c ****     char auth_buf[144], *data_ptr = NULL;
