  47:Core/Src/device/ota_download.c **** /* ==================================================================
  48:Core/Src/device/ota_download.c ****  *  主入口：由 OneNet_RevPro 调用
  49:Core/Src/device/ota_download.c ****  *  检查是否为 OTA 相关 Topic，是则处理，不是则返回 false
  50:Core/Src/device/ota_download.c ****  * ================================================================== */
  51:Core/Src/device/ota_download.c **** bool OTA_ProcessMessage(const char *topic, const char *payload, uint16_t len)
  52:Core/Src/device/ota_download.c **** {
  53:Core/Src/device/ota_download.c ****     if (topic == NULL || payload == NULL) return false;
  54:Core/Src/device/ota_download.c **** 
  55:Core/Src/device/ota_download.c ****     /* 检查 Topic 类型 */
  56:Core/Src/device/ota_download.c ****     if (strstr(topic, "ota/firmware/get")) {
  57:Core/Src/device/ota_download.c ****         /* 平台下发升级通知 */
  58:Core/Src/device/ota_download.c ****         printf("[OTA] Upgrade notification received\r\n");
  59:Core/Src/device/ota_download.c **** 
  60:Core/Src/device/ota_download.c ****         cJSON *root = cJSON_Parse(payload);
  61:Core/Src/device/ota_download.c ****         if (root == NULL) {
  62:Core/Src/device/ota_download.c ****             printf("[OTA] JSON parse failed\r\n");
  63:Core/Src/device/ota_download.c ****             return true;
  64:Core/Src/device/ota_download.c ****         }
