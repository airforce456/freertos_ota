 397:Core/Src/device/ota_download.c **** 
 398:Core/Src/device/ota_download.c ****             /* 从 Content-Length 获取实际数据长度（不能用 strlen，二进制含 \0） 
 399:Core/Src/device/ota_download.c ****             uint32_t chunk_len = 256;  /* 默认 */
 400:Core/Src/device/ota_download.c ****             char *cl = strstr(resp, "Content-Length:");
 401:Core/Src/device/ota_download.c ****             if (cl) {
 402:Core/Src/device/ota_download.c ****                 chunk_len = (uint32_t)strtoul(cl + 15, NULL, 10);
 403:Core/Src/device/ota_download.c ****             }
 404:Core/Src/device/ota_download.c ****             if (chunk_len == 0 || chunk_len > 256) chunk_len = 256;
 405:Core/Src/device/ota_download.c **** 
 406:Core/Src/device/ota_download.c ****             if (payload_len < chunk_len) {
 407:Core/Src/device/ota_download.c ****                 printf("[OTA] Incomplete chunk: got=%lu need=%lu (retry %d/2)\r\n",
 408:Core/Src/device/ota_download.c ****                        (unsigned long)payload_len, (unsigned long)chunk_len, retry + 1);
 409:Core/Src/device/ota_download.c ****                 HAL_Delay(30);
 410:Core/Src/device/ota_download.c ****                 continue;
 411:Core/Src/device/ota_download.c ****             }
