   1:Core/Src/device/ota_download.c **** /**
   2:Core/Src/device/ota_download.c ****  * @file    ota_download.c
   3:Core/Src/device/ota_download.c ****  * @brief   OneNET HTTP OTA 固件升级模块
   4:Core/Src/device/ota_download.c ****  *
   5:Core/Src/device/ota_download.c ****  * 流程：
   6:Core/Src/device/ota_download.c ****  *   1. POST /fuse-ota/{pid}/{dev}/version  → 上报版本号
   7:Core/Src/device/ota_download.c ****  *   2. GET  /fuse-ota/{pid}/{dev}/check?type=2&version=X.X → 查询任务
   8:Core/Src/device/ota_download.c ****  *   3. 有任务 → GET /fuse-ota/{pid}/{dev}/{tid}/download → 分片下载(256B/片)
   9:Core/Src/device/ota_download.c ****  *   4. 下载完 → 存 EEPROM 标志 → NVIC_SystemReset()
  10:Core/Src/device/ota_download.c ****  *
  11:Core/Src/device/ota_download.c ****  * OTA 服务器: iot-api.heclouds.com (HTTP)
  12:Core/Src/device/ota_download.c ****  * MQTT 服务器: mqtts.heclouds.com:1883 (TCP)
  13:Core/Src/device/ota_download.c ****  */
  14:Core/Src/device/ota_download.c **** #include "ota_download.h"
  15:Core/Src/device/ota_download.c **** #include "onenet.h"
  16:Core/Src/device/ota_download.c **** #include "w25q64.h"
  17:Core/Src/device/ota_download.c **** #include "at24c02.h"
  18:Core/Src/device/ota_download.c **** #include "esp8266.h"
  19:Core/Src/device/ota_download.c **** #include <string.h>
  20:Core/Src/device/ota_download.c **** #include <stdio.h>
  21:Core/Src/device/ota_download.c **** #include <stdlib.h>
  22:Core/Src/device/ota_download.c **** 
  23:Core/Src/device/ota_download.c **** #define OTA_HOST    "iot-api.heclouds.com"
  24:Core/Src/device/ota_download.c **** #define OTA_PORT    80
  25:Core/Src/device/ota_download.c **** 
  26:Core/Src/device/ota_download.c **** /* OTA 状态 */
  27:Core/Src/device/ota_download.c **** static OTA_State_t ota_state   = OTA_IDLE;
  28:Core/Src/device/ota_download.c **** static uint8_t     ota_progress = 0;
  29:Core/Src/device/ota_download.c **** 
  30:Core/Src/device/ota_download.c **** /* 固件信息 */
  31:Core/Src/device/ota_download.c **** static char     ota_tid[16]     = {0};   /* 下载任务 ID */
  32:Core/Src/device/ota_download.c **** static char     ota_new_ver[16] = {0};   /* 新版本号 */
  33:Core/Src/device/ota_download.c **** static uint32_t ota_file_size   = 0;      /* 文件总大小 */
  34:Core/Src/device/ota_download.c **** static uint32_t ota_offset      = 0;      /* 已下载字节数 */
  35:Core/Src/device/ota_download.c **** 
  36:Core/Src/device/ota_download.c **** /* ---- 当前版本号（从 EEPROM 读取）---- */
  37:Core/Src/device/ota_download.c **** static char current_version[16] = "V1.0";
  38:Core/Src/device/ota_download.c **** 
  39:Core/Src/device/ota_download.c **** static void OTA_LoadVersion(void)
  40:Core/Src/device/ota_download.c **** {
  41:Core/Src/device/ota_download.c ****     /* 从 EEPROM 读取版本号 */
  42:Core/Src/device/ota_download.c ****     AT24C02_ReadBuf(EE_VERSION_STR, (uint8_t *)current_version, sizeof(current_version) - 1);
  43:Core/Src/device/ota_download.c ****     current_version[sizeof(current_version) - 1] = '\0';
  44:Core/Src/device/ota_download.c **** 
  45:Core/Src/device/ota_download.c ****     /* 如果 EEPROM 里是空或非法，用默认值 */
  46:Core/Src/device/ota_download.c ****     if (current_version[0] == '\0' || current_version[0] == 0xFF) {
  47:Core/Src/device/ota_download.c ****         strcpy(current_version, "V1.0");
  48:Core/Src/device/ota_download.c ****     }
  49:Core/Src/device/ota_download.c **** }
  50:Core/Src/device/ota_download.c **** 
  51:Core/Src/device/ota_download.c **** /* ---- 内部函数 ---- */
  52:Core/Src/device/ota_download.c **** static bool OTA_HttpRequest(const char *method, const char *path,
  53:Core/Src/device/ota_download.c ****                             const char *extra_header, const char *body,
  54:Core/Src/device/ota_download.c ****                             char *resp, uint16_t resp_max, uint16_t timeout,
  55:Core/Src/device/ota_download.c ****                             uint16_t *resp_len);
  56:Core/Src/device/ota_download.c **** static bool OTA_ReportVersion(void);
  57:Core/Src/device/ota_download.c **** static bool OTA_CheckTask(void);
ARM GAS  C:\Users\airforce\AppData\Local\Temp\ccvns3nb.s 			page 4


  58:Core/Src/device/ota_download.c **** static bool OTA_DownloadFirmware(void);
  59:Core/Src/device/ota_download.c **** static void OTA_Finish(void);
  60:Core/Src/device/ota_download.c **** 
  61:Core/Src/device/ota_download.c **** /* ==================================================================
  62:Core/Src/device/ota_download.c ****  *  主入口：开机时调用，在连接 MQTT 之前
  63:Core/Src/device/ota_download.c ****  *  返回 true=有升级发生(已重启), false=无任务,继续正常启动
  64:Core/Src/device/ota_download.c ****  * ================================================================== */
  65:Core/Src/device/ota_download.c **** bool OTA_CheckAndDownload(void)
  66:Core/Src/device/ota_download.c **** {
  67:Core/Src/device/ota_download.c ****     /* 从 EEPROM 加载当前版本号 */
  68:Core/Src/device/ota_download.c ****     OTA_LoadVersion();
  69:Core/Src/device/ota_download.c ****     printf("[OTA] Current version: %s\r\n", current_version);
  70:Core/Src/device/ota_download.c **** 
  71:Core/Src/device/ota_download.c ****     /* 1. 上报版本号 */
  72:Core/Src/device/ota_download.c ****     if (!OTA_ReportVersion()) {
  73:Core/Src/device/ota_download.c ****         printf("[OTA] Report version failed\r\n");
  74:Core/Src/device/ota_download.c ****         return false;
  75:Core/Src/device/ota_download.c ****     }
  76:Core/Src/device/ota_download.c **** 
  77:Core/Src/device/ota_download.c ****     /* 2. 查询 OTA 任务 */
  78:Core/Src/device/ota_download.c ****     if (!OTA_CheckTask()) {
  79:Core/Src/device/ota_download.c ****         printf("[OTA] No upgrade task, continue normal boot\r\n");
  80:Core/Src/device/ota_download.c ****         return false;
  81:Core/Src/device/ota_download.c ****     }
  82:Core/Src/device/ota_download.c **** 
  83:Core/Src/device/ota_download.c ****     /* 3. 安全检查 */
  84:Core/Src/device/ota_download.c ****     if (ota_tid[0] == '\0' || ota_file_size == 0) {
  85:Core/Src/device/ota_download.c ****         printf("[OTA] Invalid tid or size, abort (no version change)\r\n");
  86:Core/Src/device/ota_download.c ****         return false;
  87:Core/Src/device/ota_download.c ****     }
  88:Core/Src/device/ota_download.c **** 
  89:Core/Src/device/ota_download.c ****     /* 4. 下载固件 */
  90:Core/Src/device/ota_download.c ****     printf("[OTA] Upgrade found: %s -> %s, size=%lu\r\n",
  91:Core/Src/device/ota_download.c ****            current_version, ota_new_ver, (unsigned long)ota_file_size);
  92:Core/Src/device/ota_download.c **** 
  93:Core/Src/device/ota_download.c ****     if (!OTA_DownloadFirmware()) {
  94:Core/Src/device/ota_download.c ****         printf("[OTA] Download failed, version NOT changed\r\n");
  95:Core/Src/device/ota_download.c ****         ota_state = OTA_FAILED;
  96:Core/Src/device/ota_download.c ****         return false;
  97:Core/Src/device/ota_download.c ****     }
  98:Core/Src/device/ota_download.c **** 
  99:Core/Src/device/ota_download.c ****     /* 5. 下载成功 → 写 EEPROM → 重启进入 Bootloader */
 100:Core/Src/device/ota_download.c ****     OTA_Finish();
 101:Core/Src/device/ota_download.c ****     return true;  /* 不会执行到这里(OTA_Finish 里会复位) */
 102:Core/Src/device/ota_download.c **** }
 103:Core/Src/device/ota_download.c **** 
 104:Core/Src/device/ota_download.c **** /* ==================================================================
 105:Core/Src/device/ota_download.c ****  *  HTTP 请求封装（阻塞，调度器启动前可用）
 106:Core/Src/device/ota_download.c ****  *
 107:Core/Src/device/ota_download.c ****  *  method:  "POST" / "GET"
 108:Core/Src/device/ota_download.c ****  *  path:    如 "/fuse-ota/xxx/d1/version"
 109:Core/Src/device/ota_download.c ****  *  extra_header: 如 "Range:bytes=0-255\r\n" 或 NULL
 110:Core/Src/device/ota_download.c ****  *  body:    POST body，GET 时传 NULL
 111:Core/Src/device/ota_download.c ****  *  resp:    输出响应缓冲区
 112:Core/Src/device/ota_download.c ****  *  timeout: 超时时间 (×10ms)
 113:Core/Src/device/ota_download.c ****  * ================================================================== */
 114:Core/Src/device/ota_download.c **** static bool OTA_HttpRequest(const char *method, const char *path,
