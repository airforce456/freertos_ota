  65:Core/Src/device/ota_download.c **** 
  66:Core/Src/device/ota_download.c ****         /* 提取消息 ID */
  67:Core/Src/device/ota_download.c ****         cJSON *id_item = cJSON_GetObjectItem(root, "id");
  68:Core/Src/device/ota_download.c ****         const char *msg_id = id_item ? id_item->valuestring : "";
  69:Core/Src/device/ota_download.c **** 
  70:Core/Src/device/ota_download.c ****         /* 提取固件信息 */
  71:Core/Src/device/ota_download.c ****         cJSON *data = cJSON_GetObjectItem(root, "data");
  72:Core/Src/device/ota_download.c ****         if (data) {
  73:Core/Src/device/ota_download.c ****             cJSON *size_item = cJSON_GetObjectItem(data, "size");
  74:Core/Src/device/ota_download.c ****             cJSON *crc_item  = cJSON_GetObjectItem(data, "sign");
  75:Core/Src/device/ota_download.c ****             cJSON *ver_item  = cJSON_GetObjectItem(data, "version");
  76:Core/Src/device/ota_download.c **** 
  77:Core/Src/device/ota_download.c ****             uint32_t fw_size = size_item ? (uint32_t)size_item->valueint : 0;
  78:Core/Src/device/ota_download.c ****             uint32_t fw_crc  = crc_item  ? (uint32_t)crc_item->valueint  : 0;
  79:Core/Src/device/ota_download.c ****             const char *ver  = ver_item  ? ver_item->valuestring         : "unknown";
  80:Core/Src/device/ota_download.c **** 
  81:Core/Src/device/ota_download.c ****             if (fw_size == 0 || fw_size > APP_MAX_SIZE) {
  82:Core/Src/device/ota_download.c ****                 printf("[OTA] Invalid firmware size: %lu\r\n", fw_size);
  83:Core/Src/device/ota_download.c ****                 OTA_ReplyGet(msg_id, 2);  /* 拒绝：大小不合法 */
  84:Core/Src/device/ota_download.c ****             } else {
  85:Core/Src/device/ota_download.c ****                 OTA_StartDownload(msg_id, fw_size, fw_crc, ver);
  86:Core/Src/device/ota_download.c ****             }
  87:Core/Src/device/ota_download.c ****         } else {
  88:Core/Src/device/ota_download.c ****             OTA_ReplyGet(msg_id, 2);
  89:Core/Src/device/ota_download.c ****         }
  90:Core/Src/device/ota_download.c **** 
  91:Core/Src/device/ota_download.c ****         cJSON_Delete(root);
  92:Core/Src/device/ota_download.c ****         return true;
  93:Core/Src/device/ota_download.c ****     }
  94:Core/Src/device/ota_download.c **** 
  95:Core/Src/device/ota_download.c ****     if (strstr(topic, "ota/firmware/data")) {
  96:Core/Src/device/ota_download.c ****         /* 平台下发固件数据分片 */
  97:Core/Src/device/ota_download.c ****         if (ota_state != OTA_DOWNLOADING) {
  98:Core/Src/device/ota_download.c ****             printf("[OTA] Data received but not in download state\r\n");
  99:Core/Src/device/ota_download.c ****             return true;
 100:Core/Src/device/ota_download.c ****         }
 101:Core/Src/device/ota_download.c **** 
 102:Core/Src/device/ota_download.c ****         cJSON *root = cJSON_Parse(payload);
 103:Core/Src/device/ota_download.c ****         if (root == NULL) return true;
 104:Core/Src/device/ota_download.c **** 
 105:Core/Src/device/ota_download.c ****         cJSON *id_item   = cJSON_GetObjectItem(root, "id");
 106:Core/Src/device/ota_download.c ****         cJSON *data_item = cJSON_GetObjectItem(root, "data");
 107:Core/Src/device/ota_download.c ****         cJSON *off_item  = cJSON_GetObjectItem(root, "offset");
 108:Core/Src/device/ota_download.c ****         cJSON *len_item  = cJSON_GetObjectItem(root, "len");
 109:Core/Src/device/ota_download.c **** 
 110:Core/Src/device/ota_download.c ****         const char *msg_id = id_item ? id_item->valuestring : "";
 111:Core/Src/device/ota_download.c ****         uint32_t offset = off_item ? (uint32_t)off_item->valueint : 0;
 112:Core/Src/device/ota_download.c ****         uint32_t chunk_len = len_item ? (uint32_t)len_item->valueint : 0;
 113:Core/Src/device/ota_download.c **** 
 114:Core/Src/device/ota_download.c ****         if (data_item && data_item->valuestring && chunk_len > 0) {
 115:Core/Src/device/ota_download.c ****             OTA_WriteChunk(offset, (const uint8_t *)data_item->valuestring, chunk_len);
 116:Core/Src/device/ota_download.c ****             OTA_ReplyData(msg_id, 0, offset + chunk_len);
 117:Core/Src/device/ota_download.c ****         } else {
 118:Core/Src/device/ota_download.c ****             OTA_ReplyData(msg_id, 1, offset);
 119:Core/Src/device/ota_download.c ****         }
 120:Core/Src/device/ota_download.c **** 
 121:Core/Src/device/ota_download.c ****         cJSON_Delete(root);
