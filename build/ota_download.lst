 122:Core/Src/device/ota_download.c ****         return true;
 123:Core/Src/device/ota_download.c ****     }
 124:Core/Src/device/ota_download.c **** 
 125:Core/Src/device/ota_download.c ****     return false;  /* 非 OTA 消息 */
 126:Core/Src/device/ota_download.c **** }
