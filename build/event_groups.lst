  60:Middlewares/FreeRTOS/Source/event_groups.c ****     #define eventWAIT_FOR_ALL_BITS           0x04000000UL
  61:Middlewares/FreeRTOS/Source/event_groups.c ****     #define eventEVENT_BITS_CONTROL_BYTES    0xff000000UL
  62:Middlewares/FreeRTOS/Source/event_groups.c **** #endif
