  49:Middlewares/FreeRTOS/Source/event_groups.c **** /* The following bit fields convey control information in a task's event list
  50:Middlewares/FreeRTOS/Source/event_groups.c ****  * item value.  It is important they don't clash with the
  51:Middlewares/FreeRTOS/Source/event_groups.c ****  * taskEVENT_LIST_ITEM_VALUE_IN_USE definition. */
  52:Middlewares/FreeRTOS/Source/event_groups.c **** #if configUSE_16_BIT_TICKS == 1
  53:Middlewares/FreeRTOS/Source/event_groups.c ****     #define eventCLEAR_EVENTS_ON_EXIT_BIT    0x0100U
  54:Middlewares/FreeRTOS/Source/event_groups.c ****     #define eventUNBLOCKED_DUE_TO_BIT_SET    0x0200U
  55:Middlewares/FreeRTOS/Source/event_groups.c ****     #define eventWAIT_FOR_ALL_BITS           0x0400U
  56:Middlewares/FreeRTOS/Source/event_groups.c ****     #define eventEVENT_BITS_CONTROL_BYTES    0xff00U
  57:Middlewares/FreeRTOS/Source/event_groups.c **** #else
  58:Middlewares/FreeRTOS/Source/event_groups.c ****     #define eventCLEAR_EVENTS_ON_EXIT_BIT    0x01000000UL
