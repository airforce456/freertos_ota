  46:Middlewares/FreeRTOS/Source/event_groups.c ****  * correct privileged Vs unprivileged linkage and placement. */
  47:Middlewares/FreeRTOS/Source/event_groups.c **** #undef MPU_WRAPPERS_INCLUDED_FROM_API_FILE /*lint !e961 !e750 !e9021 See comment above. */
