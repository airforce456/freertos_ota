  55:Middlewares/FreeRTOS/Source/event_groups.c ****     #define eventWAIT_FOR_ALL_BITS           0x0400U
  56:Middlewares/FreeRTOS/Source/event_groups.c ****     #define eventEVENT_BITS_CONTROL_BYTES    0xff00U
  57:Middlewares/FreeRTOS/Source/event_groups.c **** #else
