 461:Core/Src/device/hmac_sha1.c **** 		/* iterate a-e 80 times */
 462:Core/Src/device/hmac_sha1.c **** 
 463:Core/Src/device/hmac_sha1.c **** 		for(t = 0; t < 80; t++)
 464:Core/Src/device/hmac_sha1.c **** 		{
 465:Core/Src/device/hmac_sha1.c **** 			temp = (rotl(5, a) + ft(t, b, c, d)) & 0xffffffff;
