 236:Middlewares/FreeRTOS/Source/tasks.c **** /* The item value of the event list item is normally used to hold the priority
 237:Middlewares/FreeRTOS/Source/tasks.c ****  * of the task to which it belongs (coded to allow it to be held in reverse
 238:Middlewares/FreeRTOS/Source/tasks.c ****  * priority order).  However, it is occasionally borrowed for other purposes.  It
 239:Middlewares/FreeRTOS/Source/tasks.c ****  * is important its value is not updated due to a task priority change while it is
 240:Middlewares/FreeRTOS/Source/tasks.c ****  * being used for another purpose.  The following bit definition is used to inform
 241:Middlewares/FreeRTOS/Source/tasks.c ****  * the scheduler that the value should not be changed - in which case it is the
 242:Middlewares/FreeRTOS/Source/tasks.c ****  * responsibility of whichever module is using the value to ensure it gets set back
 243:Middlewares/FreeRTOS/Source/tasks.c ****  * to its original value when it is released. */
 244:Middlewares/FreeRTOS/Source/tasks.c **** #if ( configUSE_16_BIT_TICKS == 1 )
 245:Middlewares/FreeRTOS/Source/tasks.c ****     #define taskEVENT_LIST_ITEM_VALUE_IN_USE    0x8000U
 246:Middlewares/FreeRTOS/Source/tasks.c **** #else
 247:Middlewares/FreeRTOS/Source/tasks.c ****     #define taskEVENT_LIST_ITEM_VALUE_IN_USE    0x80000000UL
 248:Middlewares/FreeRTOS/Source/tasks.c **** #endif
