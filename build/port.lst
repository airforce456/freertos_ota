 173:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c **** /*
 174:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****  * See header file for description.
 175:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****  */
 176:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c **** StackType_t * pxPortInitialiseStack( StackType_t * pxTopOfStack,
 177:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****                                      TaskFunction_t pxCode,
 178:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****                                      void * pvParameters )
 179:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c **** {
 180:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****     /* Simulate the stack frame as it would be created by a context switch
 181:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****      * interrupt. */
 182:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****     pxTopOfStack--;                                                      /* Offset added to account
 183:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****     *pxTopOfStack = portINITIAL_XPSR;                                    /* xPSR */
 184:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****     pxTopOfStack--;
 185:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****     *pxTopOfStack = ( ( StackType_t ) pxCode ) & portSTART_ADDRESS_MASK; /* PC */
 186:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****     pxTopOfStack--;
 187:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****     *pxTopOfStack = ( StackType_t ) portTASK_RETURN_ADDRESS;             /* LR */
 188:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****     pxTopOfStack -= 5;                                                   /* R12, R3, R2 and R1. */
 189:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****     *pxTopOfStack = ( StackType_t ) pvParameters;                        /* R0 */
 190:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c ****     pxTopOfStack -= 8;                                                   /* R11, R10, R9, R8, R7, R
 191:Middlewares/FreeRTOS/Source/portable/GCC/ARM_CM3/port.c **** 
