 256:Core/Src/main.c **** /* ===== 2.1B: OLED 显示任务（消费者） ===== */
 257:Core/Src/main.c **** void Task_OLED_Display(void *argument)
 258:Core/Src/main.c **** {
 259:Core/Src/main.c ****     QueueHandle_t q = (QueueHandle_t)argument;
 260:Core/Src/main.c ****     SensorCooked_t data;
 261:Core/Src/main.c ****     uint32_t count = 0;
 262:Core/Src/main.c ****     /* 清屏后显示 hello */
 263:Core/Src/main.c ****     OLED_Fill(0x00);
 264:Core/Src/main.c ****     OLED_ShowString(0, 0, "hello");
 265:Core/Src/main.c ****     printf("[OLED] Task started, q=%p\r\n", (void*)q);
 266:Core/Src/main.c ****     while (1) {
 267:Core/Src/main.c ****         if (xQueueReceive(q, &data, portMAX_DELAY) == pdPASS) {
 268:Core/Src/main.c ****             count++;
 269:Core/Src/main.c ****             /* 获取 I2C 总线锁，保护 OLED 写操作 */
 270:Core/Src/main.c ****             if (xSemaphoreTake(xI2CMutex, pdMS_TO_TICKS(100)) == pdPASS) {
 271:Core/Src/main.c ****                 OLED_ShowNum(2, 1, data.ax_g);
 272:Core/Src/main.c ****                 OLED_ShowNum(3, 1, data.ay_g);
 273:Core/Src/main.c ****                 OLED_ShowNum(4, 1, data.az_g);
 274:Core/Src/main.c ****                 OLED_ShowNum(4, 100, (float)count);
 275:Core/Src/main.c ****                 xSemaphoreGive(xI2CMutex);
 276:Core/Src/main.c ****             }
 277:Core/Src/main.c ****             printf("[OLED] #%lu ax=%+.3f ay=%+.3f az=%+.3f\r\n",
 278:Core/Src/main.c ****                    count, data.ax_g, data.ay_g, data.az_g);
 279:Core/Src/main.c ****         }
 280:Core/Src/main.c ****     }
 281:Core/Src/main.c **** }
