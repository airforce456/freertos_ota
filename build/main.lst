 114:Core/Src/main.c **** 
 115:Core/Src/main.c ****   /* 零漂校准：在创建任务前完成，避免 I2C 竞争 */
 116:Core/Src/main.c ****   {
 117:Core/Src/main.c ****       MPU6050_Data_t cal_data;
 118:Core/Src/main.c ****       int32_t ax_sum = 0, ay_sum = 0, az_sum = 0;
 119:Core/Src/main.c ****       for (int i = 0; i < 100; i++) {
 120:Core/Src/main.c ****           MPU6050_ReadAll(&cal_data);
 121:Core/Src/main.c ****           ax_sum += cal_data.ax;
 122:Core/Src/main.c ****           ay_sum += cal_data.ay;
 123:Core/Src/main.c ****           az_sum += cal_data.az;
 124:Core/Src/main.c ****           HAL_Delay(5);
 125:Core/Src/main.c ****       }
 126:Core/Src/main.c ****       ProcessTaskParam.ax_offset = (int16_t)(ax_sum / 100);
 127:Core/Src/main.c ****       ProcessTaskParam.ay_offset = (int16_t)(ay_sum / 100);
 128:Core/Src/main.c ****       ProcessTaskParam.az_offset = (int16_t)(az_sum / 100);
 129:Core/Src/main.c ****       printf("[Calib] offset: ax=%d ay=%d az=%d\r\n",
 130:Core/Src/main.c ****              ProcessTaskParam.ax_offset, ProcessTaskParam.ay_offset, ProcessTaskParam.az_offset);
 131:Core/Src/main.c ****   }
 132:Core/Src/main.c ****   /* 创建队列：8 个 MPU6050_Data_t 槽位 */
 133:Core/Src/main.c ****   xSensorQueue = xQueueCreate(8, sizeof(MPU6050_Data_t));
 134:Core/Src/main.c ****   if (xSensorQueue == NULL) {
 135:Core/Src/main.c ****       printf("[Queue] Create FAILED!\r\n");
 136:Core/Src/main.c ****   } else {
 137:Core/Src/main.c ****       printf("[Queue] Created (8 slots x %u bytes)\r\n", (unsigned)sizeof(MPU6050_Data_t));
