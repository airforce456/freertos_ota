 107:Core/Src/main.c ****   MX_I2C1_Init();
 108:Core/Src/main.c **** 
 109:Core/Src/main.c ****   /* 手动读 WHO_AM_I：先写寄存器号，再读（F1 的 I2C 外设 Mem_Read 有重复起始�
 110:Core/Src/main.c ****   {
 111:Core/Src/main.c ****       uint8_t reg = 0x75, who;
 112:Core/Src/main.c ****       HAL_StatusTypeDef rc;
 113:Core/Src/main.c ****       rc = HAL_I2C_Master_Transmit(&hi2c1, 0x68 << 1, &reg, 1, 100);
 114:Core/Src/main.c ****       if (rc == HAL_OK) {
 115:Core/Src/main.c ****           rc = HAL_I2C_Master_Receive(&hi2c1, 0x68 << 1, &who, 1, 100);
 116:Core/Src/main.c ****       }
 117:Core/Src/main.c ****       printf("[MPU] Raw WHO_AM_I: rc=%d val=0x%02X (expect rc=0 val=0x68)\r\n",
