  90:Core/Src/main.c ****   /* ---- I2C 总线扫描，确认设备在线 ---- */
  91:Core/Src/main.c ****   printf("I2C Scan: ");
  92:Core/Src/main.c ****   int found = 0;
  93:Core/Src/main.c ****   for (uint8_t addr = 1; addr < 127; addr++) {
  94:Core/Src/main.c ****       if (HAL_I2C_IsDeviceReady(&hi2c1, (uint16_t)(addr << 1), 2, 10) == HAL_OK) {
  95:Core/Src/main.c ****           printf("0x%02X ", addr);
  96:Core/Src/main.c ****           found++;
  97:Core/Src/main.c ****       }
  98:Core/Src/main.c ****   }
  99:Core/Src/main.c ****   if (found == 0) {
 100:Core/Src/main.c ****       printf("NO DEVICE FOUND!\r\n");
 101:Core/Src/main.c ****   } else {
 102:Core/Src/main.c ****       printf("(%d device(s))\r\n", found);
 103:Core/Src/main.c ****   }
 104:Core/Src/main.c **** 
 105:Core/Src/main.c ****   /* 扫描后复位 I2C 状态机，否则后续 HAL_I2C_Mem_Read 会脏 */
