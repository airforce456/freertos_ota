 271:Core/Src/main.c ****                 xSemaphoreGive(xI2CMutex);
 272:Core/Src/main.c ****             }
 273:Core/Src/main.c ****             printf("[OLED] #%lu ax=%+.3f ay=%+.3f az=%+.3f\r\n",
 274:Core/Src/main.c ****                    count, data.ax_g, data.ay_g, data.az_g);
 275:Core/Src/main.c ****         }
