 265:Core/Src/main.c **** /* ===== 2.1B: OLED 显示任务（消费者） ===== */
 266:Core/Src/main.c **** void Task_OLED_Display(void *argument)
 267:Core/Src/main.c **** {
 268:Core/Src/main.c ****     QueueHandle_t q = (QueueHandle_t)argument;
 269:Core/Src/main.c ****     SensorCooked_t data;
 270:Core/Src/main.c ****     uint32_t count = 0;
 271:Core/Src/main.c ****     /* 清屏后显示 hello */
 272:Core/Src/main.c ****     OLED_Fill(0x00);
 273:Core/Src/main.c ****     OLED_ShowString(0, 0, "hello");
 274:Core/Src/main.c ****     printf("[OLED] Task started, q=%p\r\n", (void *)q);
 275:Core/Src/main.c ****     while (1) {
 276:Core/Src/main.c ****         if (xQueueReceive(q, &data, portMAX_DELAY) == pdPASS) {
 277:Core/Src/main.c ****             count++;
 278:Core/Src/main.c ****             /* 获取 I2C 总线锁，保护 OLED 写操作 */
 279:Core/Src/main.c ****             if (xSemaphoreTake(xI2CMutex, pdMS_TO_TICKS(100)) == pdPASS) {
 280:Core/Src/main.c ****                 OLED_ShowNum(2, 1, data.ax_g);
 281:Core/Src/main.c ****                 OLED_ShowNum(3, 1, data.ay_g);
 282:Core/Src/main.c ****                 OLED_ShowNum(4, 1, data.az_g);
 283:Core/Src/main.c ****                 OLED_ShowNum(4, 100, (float)count);
 284:Core/Src/main.c ****                 xSemaphoreGive(xI2CMutex);
 285:Core/Src/main.c ****             }
 286:Core/Src/main.c ****             printf("[OLED] #%lu ax=%+.3f ay=%+.3f az=%+.3f\r\n",
 287:Core/Src/main.c ****                    count, data.ax_g, data.ay_g, data.az_g);
 288:Core/Src/main.c ****         }
 289:Core/Src/main.c ****     }
 290:Core/Src/main.c **** }
 291:Core/Src/main.c **** 
