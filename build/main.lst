 268:Core/Src/main.c **** /* ==================================================================
 269:Core/Src/main.c ****  *  Experiment 2: Self-deleting task
 270:Core/Src/main.c ****  *  Task waits 3 seconds, prints farewell, then deletes itself.
 271:Core/Src/main.c ****  *  Watch vTaskList output �?? the task disappears after deletion.
 272:Core/Src/main.c ****  * ================================================================== */
 273:Core/Src/main.c **** 
 274:Core/Src/main.c **** void Task_SelfDelete(void *argument)
 275:Core/Src/main.c **** {
 276:Core/Src/main.c ****     (void)argument;
 277:Core/Src/main.c ****     printf("[SelfDel] Hello! I will delete myself in 3 seconds...\r\n");
 278:Core/Src/main.c ****     vTaskDelay(pdMS_TO_TICKS(3000));
 279:Core/Src/main.c ****     printf("[SelfDel] Goodbye! Calling vTaskDelete(NULL)...\r\n");
 280:Core/Src/main.c ****     vTaskDelete(NULL);
 281:Core/Src/main.c ****     /* Execution never reaches here */
ARM GAS  C:\Users\airforce\AppData\Local\Temp\cc6Bogev.s 			page 11


 282:Core/Src/main.c **** }
 283:Core/Src/main.c **** 
 284:Core/Src/main.c **** 
 285:Core/Src/main.c **** /* ==================================================================
 286:Core/Src/main.c ****  *  Experiment 3: Task list reporter
 287:Core/Src/main.c ****  *  Prints all tasks and their states every 5 seconds via vTaskList().
 288:Core/Src/main.c ****  *  Shows: task name, state (R=Ready, B=Blocked, D=Deleted, S=Suspended),
 289:Core/Src/main.c ****  *  priority, stack high-water mark, task number.
 290:Core/Src/main.c ****  * ================================================================== */
 291:Core/Src/main.c **** 
 292:Core/Src/main.c **** void Task_ListReporter(void *argument)
 293:Core/Src/main.c **** {
 294:Core/Src/main.c ****     (void)argument;
 295:Core/Src/main.c ****     char buf[512];
 296:Core/Src/main.c **** 
 297:Core/Src/main.c ****     /* Wait for SelfDel task to disappear first */
 298:Core/Src/main.c ****     vTaskDelay(pdMS_TO_TICKS(5000));
 299:Core/Src/main.c **** 
 300:Core/Src/main.c ****     while (1) {
 301:Core/Src/main.c ****         vTaskList(buf);
 302:Core/Src/main.c ****         printf("========== Task List ==========\r\n");
 303:Core/Src/main.c ****         printf("%s\r\n", buf);
 304:Core/Src/main.c ****         printf("===============================\r\n\r\n");
 305:Core/Src/main.c ****         vTaskDelay(pdMS_TO_TICKS(5000));
 306:Core/Src/main.c ****     }
 307:Core/Src/main.c **** }
 308:Core/Src/main.c **** 
 309:Core/Src/main.c **** 
