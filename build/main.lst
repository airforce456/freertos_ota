 273:Core/Src/main.c **** /* ===== 2.1B: OLED 显示任务（消费�?�） ===== */
 274:Core/Src/main.c **** void Task_OLED_Display(void *argument)
 275:Core/Src/main.c **** {
 276:Core/Src/main.c ****     QueueHandle_t q = (QueueHandle_t)argument;
 277:Core/Src/main.c ****     SensorCooked_t data;
 278:Core/Src/main.c ****     uint32_t count = 0;
 279:Core/Src/main.c ****     /* 清屏后显�? hello */
 280:Core/Src/main.c ****     OLED_Fill(0x00);
 281:Core/Src/main.c ****     OLED_ShowString(0, 0, "hello");
 282:Core/Src/main.c ****     printf("[OLED] Task started, q=%p\r\n", (void *)q);
 283:Core/Src/main.c ****     while (1) {
 284:Core/Src/main.c ****         if (xQueueReceive(q, &data, portMAX_DELAY) == pdPASS) {
 285:Core/Src/main.c ****             count++;
 286:Core/Src/main.c ****             /* 获取 I2C 总线锁，保护 OLED 写操�? */
 287:Core/Src/main.c ****             if (xSemaphoreTake(xI2CMutex, pdMS_TO_TICKS(100)) == pdPASS) {
 288:Core/Src/main.c ****                 OLED_ShowNum(2, 1, data.ax_g);
 289:Core/Src/main.c ****                 OLED_ShowNum(3, 1, data.ay_g);
 290:Core/Src/main.c ****                 OLED_ShowNum(4, 1, data.az_g);
 291:Core/Src/main.c ****                 OLED_ShowNum(4, 100, (float)count);
 292:Core/Src/main.c ****                 xSemaphoreGive(xI2CMutex);
 293:Core/Src/main.c ****             }
 294:Core/Src/main.c ****             printf("[OLED] #%lu ax=%+.3f ay=%+.3f az=%+.3f\r\n",
 295:Core/Src/main.c ****                    count, data.ax_g, data.ay_g, data.az_g);
 296:Core/Src/main.c ****         }
 297:Core/Src/main.c ****     }
 298:Core/Src/main.c **** }
