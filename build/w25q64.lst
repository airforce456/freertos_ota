  22:Core/Src/device/w25q64.c **** 
  23:Core/Src/device/w25q64.c **** /* ---- CS pin: PA4 ---- */
  24:Core/Src/device/w25q64.c **** #define W25Q64_CS_PORT      GPIOA
  25:Core/Src/device/w25q64.c **** #define W25Q64_CS_PIN       GPIO_PIN_4
  26:Core/Src/device/w25q64.c **** 
  27:Core/Src/device/w25q64.c **** #define CS_LOW()    (W25Q64_CS_PORT->BRR = W25Q64_CS_PIN)
  28:Core/Src/device/w25q64.c **** #define CS_HIGH()   (W25Q64_CS_PORT->BSRR = W25Q64_CS_PIN)
  29:Core/Src/device/w25q64.c **** 
  30:Core/Src/device/w25q64.c **** /* ---- SPI commands ---- */
  31:Core/Src/device/w25q64.c **** #define CMD_WRITE_ENABLE    0x06
  32:Core/Src/device/w25q64.c **** #define CMD_READ_SR1        0x05
ARM GAS  C:\Users\airforce\AppData\Local\Temp\ccDHGl9K.s 			page 2


