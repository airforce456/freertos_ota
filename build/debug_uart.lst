  10:Core/Src/device/debug_uart.c **** #define UART_TX_QUEUE_LEN   16    /* queue depth: buffer 16 messages */
  11:Core/Src/device/debug_uart.c **** #define UART_RX_QUEUE_LEN    8    /* queue depth: buffer 8 messages */
  12:Core/Src/device/debug_uart.c **** #define UART_TX_BUF_SIZE    64    /* max bytes per message */
  13:Core/Src/device/debug_uart.c **** #define UART_MSG_BUF_SIZE   64    /* max bytes per message (RX msg buffer) */
  14:Core/Src/device/debug_uart.c **** #define UART_DMA_RX_BUF_SIZE 128  /* DMA RX buffer size (must be >= MSG_BUF_SIZE) */
  15:Core/Src/device/debug_uart.c **** 
  16:Core/Src/device/debug_uart.c **** static QueueHandle_t     xUartTxQueue      = NULL;
  17:Core/Src/device/debug_uart.c **** static QueueHandle_t     xUartRxQueue      = NULL;
  18:Core/Src/device/debug_uart.c **** static SemaphoreHandle_t xTxDmaSemaphore   = NULL;  /* DMA TX complete signal */
  19:Core/Src/device/debug_uart.c **** static SemaphoreHandle_t xRxDmaSemaphore   = NULL;  /* DMA RX complete signal */
  20:Core/Src/device/debug_uart.c **** 
