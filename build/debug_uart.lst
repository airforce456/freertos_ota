  24:Core/Src/debug_uart.c **** /* ===== Init debug UART (create queue + TX task + DMA semaphore) ===== */
  25:Core/Src/debug_uart.c **** void DebugUART_Init(void)
  26:Core/Src/debug_uart.c **** {
