  39:Core/Src/debug_uart.c **** /* ===== _write: printf redirect to UART ===== */
  40:Core/Src/debug_uart.c **** int _write(int file, char *ptr, int len)
  41:Core/Src/debug_uart.c **** {
  42:Core/Src/debug_uart.c ****     (void)file;
  43:Core/Src/debug_uart.c **** 
  44:Core/Src/debug_uart.c ****     /* Before scheduler starts, fallback to blocking polling transmit */
  45:Core/Src/debug_uart.c ****     if (xUartTxQueue == NULL) {
  46:Core/Src/debug_uart.c ****         HAL_UART_Transmit_DMA(&huart1, (uint8_t *)ptr, len);
  47:Core/Src/debug_uart.c ****         return len;
  48:Core/Src/debug_uart.c ****     }
  49:Core/Src/debug_uart.c **** 
  50:Core/Src/debug_uart.c ****     /* Push data chunks into queue */
  51:Core/Src/debug_uart.c ****     size_t offset = 0;
  52:Core/Src/debug_uart.c ****     while (offset < (size_t)len) {
  53:Core/Src/debug_uart.c ****         UartTxMsg_t msg;
  54:Core/Src/debug_uart.c ****         size_t chunk = (size_t)len - offset;
  55:Core/Src/debug_uart.c ****         if (chunk > UART_TX_BUF_SIZE) chunk = UART_TX_BUF_SIZE;
  56:Core/Src/debug_uart.c ****         memcpy(msg.data, ptr + offset, chunk);
  57:Core/Src/debug_uart.c ****         msg.len = (uint16_t)chunk;
  58:Core/Src/debug_uart.c **** 
  59:Core/Src/debug_uart.c ****         if (xQueueSend(xUartTxQueue, &msg, pdMS_TO_TICKS(10)) != pdPASS) {
  60:Core/Src/debug_uart.c ****             break;  /* drop remaining data if queue full */
  61:Core/Src/debug_uart.c ****         }
  62:Core/Src/debug_uart.c ****         offset += chunk;
  63:Core/Src/debug_uart.c ****     }
  64:Core/Src/debug_uart.c ****     return len;
  65:Core/Src/debug_uart.c **** }
