  35:Core/Src/device/debug_uart.c **** /* ===== Init debug UART (create queue + TX task + DMA semaphore) ===== */
  36:Core/Src/device/debug_uart.c **** void DebugUART_Init(void)
  37:Core/Src/device/debug_uart.c **** {
  38:Core/Src/device/debug_uart.c ****     if (xUartTxQueue != NULL) return;  /* already initialized */
  39:Core/Src/device/debug_uart.c **** 
  40:Core/Src/device/debug_uart.c ****     /* Create binary semaphore for DMA TX complete signaling */
  41:Core/Src/device/debug_uart.c ****     xTxDmaSemaphore = xSemaphoreCreateBinary();
  42:Core/Src/device/debug_uart.c ****     if (xTxDmaSemaphore == NULL) return;
  43:Core/Src/device/debug_uart.c **** 
  44:Core/Src/device/debug_uart.c ****     xUartTxQueue = xQueueCreate(UART_TX_QUEUE_LEN, sizeof(UartTxMsg_t));
  45:Core/Src/device/debug_uart.c ****     if (xUartTxQueue != NULL) {
  46:Core/Src/device/debug_uart.c ****         xTaskCreate(vUartTxTask, "UartTX", 256, NULL, 2, NULL);
  47:Core/Src/device/debug_uart.c ****     }
  48:Core/Src/device/debug_uart.c **** 
  49:Core/Src/device/debug_uart.c ****     xUartRxQueue = xQueueCreate(UART_RX_QUEUE_LEN, sizeof(UartRxMsg_t));
  50:Core/Src/device/debug_uart.c ****     if (xUartRxQueue != NULL) {
  51:Core/Src/device/debug_uart.c ****         xTaskCreate(vUartRxTask, "UartRX", 256, NULL, 2, NULL);
  52:Core/Src/device/debug_uart.c ****     }
  53:Core/Src/device/debug_uart.c ****     /* RX DMA is started in vUartRxTask to avoid DMA conflict with initial TX */
  54:Core/Src/device/debug_uart.c **** }
  55:Core/Src/device/debug_uart.c **** 
  56:Core/Src/device/debug_uart.c **** /* ===== _write: printf redirect to UART ===== */
  57:Core/Src/device/debug_uart.c **** int _write(int file, char *ptr, int len)
  58:Core/Src/device/debug_uart.c **** {
  59:Core/Src/device/debug_uart.c ****     (void)file;
  60:Core/Src/device/debug_uart.c **** 
  61:Core/Src/device/debug_uart.c ****     /* Before scheduler starts (or before queue init), fallback to blocking transmit */
  62:Core/Src/device/debug_uart.c ****     if (xUartTxQueue == NULL || xTaskGetSchedulerState() != taskSCHEDULER_RUNNING) {
  63:Core/Src/device/debug_uart.c ****         HAL_UART_Transmit(&huart1, (uint8_t *)ptr, len, HAL_MAX_DELAY);
  64:Core/Src/device/debug_uart.c ****         return len;
  65:Core/Src/device/debug_uart.c ****     }
  66:Core/Src/device/debug_uart.c **** 
  67:Core/Src/device/debug_uart.c ****     /* Push data chunks into queue */
  68:Core/Src/device/debug_uart.c ****     size_t offset = 0;
  69:Core/Src/device/debug_uart.c ****     while (offset < (size_t)len) {
  70:Core/Src/device/debug_uart.c ****         UartTxMsg_t msg;
  71:Core/Src/device/debug_uart.c ****         size_t chunk = (size_t)len - offset;
  72:Core/Src/device/debug_uart.c ****         if (chunk > UART_TX_BUF_SIZE) chunk = UART_TX_BUF_SIZE;
  73:Core/Src/device/debug_uart.c ****         memcpy(msg.data, ptr + offset, chunk);
  74:Core/Src/device/debug_uart.c ****         msg.len = (uint16_t)chunk;
  75:Core/Src/device/debug_uart.c **** 
  76:Core/Src/device/debug_uart.c ****         if (xQueueSend(xUartTxQueue, &msg, pdMS_TO_TICKS(10)) != pdPASS) {
  77:Core/Src/device/debug_uart.c ****             break;  /* drop remaining data if queue full */
  78:Core/Src/device/debug_uart.c ****         }
  79:Core/Src/device/debug_uart.c ****         offset += chunk;
  80:Core/Src/device/debug_uart.c ****     }
  81:Core/Src/device/debug_uart.c ****     return len;
  82:Core/Src/device/debug_uart.c **** }
