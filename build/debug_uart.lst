  34:Core/Src/debug_uart.c **** /* ===== Init debug UART (create queue + TX task + DMA semaphore) ===== */
  35:Core/Src/debug_uart.c **** void DebugUART_Init(void)
  36:Core/Src/debug_uart.c **** {
  37:Core/Src/debug_uart.c ****     if (xUartTxQueue != NULL) return;  /* already initialized */
  38:Core/Src/debug_uart.c **** 
  39:Core/Src/debug_uart.c ****     /* Create binary semaphore for DMA TX complete signaling */
  40:Core/Src/debug_uart.c ****     xTxDmaSemaphore = xSemaphoreCreateBinary();
  41:Core/Src/debug_uart.c ****     if (xTxDmaSemaphore == NULL) return;
  42:Core/Src/debug_uart.c **** 
  43:Core/Src/debug_uart.c ****     xUartTxQueue = xQueueCreate(UART_TX_QUEUE_LEN, sizeof(UartTxMsg_t));
  44:Core/Src/debug_uart.c ****     if (xUartTxQueue != NULL) {
  45:Core/Src/debug_uart.c ****         xTaskCreate(vUartTxTask, "UartTX", 256, NULL, 1, NULL);
  46:Core/Src/debug_uart.c ****     }
  47:Core/Src/debug_uart.c **** 
  48:Core/Src/debug_uart.c ****     xUartRxQueue = xQueueCreate(UART_RX_QUEUE_LEN, sizeof(UartRxMsg_t));
  49:Core/Src/debug_uart.c ****     if (xUartRxQueue != NULL) {
  50:Core/Src/debug_uart.c ****         xTaskCreate(vUartRxTask, "UartRX", 256, NULL, 1, NULL);
  51:Core/Src/debug_uart.c ****     }
  52:Core/Src/debug_uart.c ****     DebugUART_StartRx(); 
  53:Core/Src/debug_uart.c **** }
