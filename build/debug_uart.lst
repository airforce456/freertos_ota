  55:Core/Src/debug_uart.c **** /* ===== _write: printf redirect to UART ===== */
  56:Core/Src/debug_uart.c **** int _write(int file, char *ptr, int len)
  57:Core/Src/debug_uart.c **** {
  58:Core/Src/debug_uart.c ****     (void)file;
  59:Core/Src/debug_uart.c **** 
  60:Core/Src/debug_uart.c ****     /* Before scheduler starts, fallback to blocking polling transmit */
  61:Core/Src/debug_uart.c ****     if (xUartTxQueue == NULL) {
  62:Core/Src/debug_uart.c ****         HAL_UART_Transmit(&huart1, (uint8_t *)ptr, len, HAL_MAX_DELAY);
  63:Core/Src/debug_uart.c ****         return len;
  64:Core/Src/debug_uart.c ****     }
  65:Core/Src/debug_uart.c **** 
  66:Core/Src/debug_uart.c ****     /* Push data chunks into queue */
  67:Core/Src/debug_uart.c ****     size_t offset = 0;
  68:Core/Src/debug_uart.c ****     while (offset < (size_t)len) {
  69:Core/Src/debug_uart.c ****         UartTxMsg_t msg;
  70:Core/Src/debug_uart.c ****         size_t chunk = (size_t)len - offset;
  71:Core/Src/debug_uart.c ****         if (chunk > UART_TX_BUF_SIZE) chunk = UART_TX_BUF_SIZE;
  72:Core/Src/debug_uart.c ****         memcpy(msg.data, ptr + offset, chunk);
  73:Core/Src/debug_uart.c ****         msg.len = (uint16_t)chunk;
  74:Core/Src/debug_uart.c **** 
  75:Core/Src/debug_uart.c ****         if (xQueueSend(xUartTxQueue, &msg, pdMS_TO_TICKS(10)) != pdPASS) {
  76:Core/Src/debug_uart.c ****             break;  /* drop remaining data if queue full */
  77:Core/Src/debug_uart.c ****         }
  78:Core/Src/debug_uart.c ****         offset += chunk;
  79:Core/Src/debug_uart.c ****     }
  80:Core/Src/debug_uart.c ****     return len;
  81:Core/Src/debug_uart.c **** }
  82:Core/Src/debug_uart.c **** 
